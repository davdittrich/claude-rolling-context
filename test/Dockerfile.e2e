# Builds the e2e container used by docker-compose.e2e.yml (build.context: .,
# build.dockerfile: test/Dockerfile.e2e). proxy/server.py and
# proxy/compressor.py are pure stdlib Python (see server.py's own docstring:
# "Pure stdlib — no external dependencies needed"), so this image installs
# nothing beyond the base — no pip, no requirements file.
#
# UNVERIFIED: docker is unavailable in the environment that authored this
# file (Gemini-e86.21), and `python3 -m unittest discover -s tests` never
# builds or runs this image — see tests/test_store_integration.py's module
# docstring for the sanctioned Python-level fallback. This Dockerfile is
# correct-by-construction against docker-compose.e2e.yml and proxy/server.py
# but has NOT been build- or run-tested. Verify locally with:
#   docker compose -f docker-compose.e2e.yml up --build
#
# docker-compose.e2e.yml sets ROLLING_CONTEXT_PORT=5588 via `environment:`
# and does not publish a host port, so 5588 here is the container-internal
# listen port only, not a published port.
FROM python:3.12-slim

WORKDIR /app

COPY proxy/ proxy/
COPY test/entrypoint.sh entrypoint.sh
RUN chmod +x entrypoint.sh

EXPOSE 5588

ENTRYPOINT ["./entrypoint.sh"]
